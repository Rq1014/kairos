# 本地开发示例：复制为 application-local.yml（已 gitignore）
# 启动时加 -Dspring.profiles.active=local，或 export DB_PASSWORD=xxx 走环境变量
#
# 也可以直接 export 到 shell：
#   export DB_HOST=127.0.0.1
#   export DB_PORT=3306
#   export DB_NAME=kakomon
#   export DB_USERNAME=root
#   export DB_PASSWORD=your-mysql-password
#   export REDIS_HOST=127.0.0.1
#   export REDIS_PORT=6379
#   export REDIS_PASSWORD=
#   export REDIS_DB=0
#   export JWT_SECRET=your-32-bytes-min-secret-please-change

spring:
  datasource:
    username: root
    password: your-mysql-password
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password:

auth:
  jwt:
    secret: your-32-bytes-min-secret-please-change
